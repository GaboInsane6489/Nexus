# ==============================================================================
# Nexus Platform — Docker Environment Template
# Copy to .env.docker and replace placeholder values before running:
#   docker compose --env-file .env.docker up -d --build
# ==============================================================================

# --- Supabase (Required for Next.js build & runtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional server-side admin key for privileged Next.js Server Actions / webhooks
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Application Public URL ---
# Public origin served through Nginx or Cloudflare Tunnel (e.g. https://nexus.example.com)
NEXT_PUBLIC_APP_URL=http://localhost

# --- n8n PostgreSQL Database ---
N8N_DB_USER=n8n
N8N_DB_PASSWORD=replace-with-strong-postgres-password
N8N_DB_NAME=n8n

# --- n8n Security & Webhooks ---
# Generate a 32+ char hex key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-random-encryption-key
# Public base URL where n8n webhooks are reachable
N8N_WEBHOOK_URL=http://localhost/
# Shared HMAC / header secret between Nexus and n8n webhooks
N8N_WEBHOOK_SECRET=replace-with-shared-webhook-secret

# --- Cloudflare Tunnel (Required only when using --profile tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=
